    {
      "name": "Transacciones",
      "description": "Gestión de transacciones (compras/alquileres). Los usuarios pueden crear transacciones para productos de otros usuarios. El vendedor puede completar la transacción. Ambos (comprador y vendedor) pueden cancelarla mientras esté pendiente.",
      "item": [
        {
          "name": "Crear Transacción",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productoId\": 1,\n  \"tipo\": \"COMPRA\"\n}"
            },
            "url": {
