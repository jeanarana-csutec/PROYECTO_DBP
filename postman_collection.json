              "host": ["{{base_url}}"],
              "path": ["api", "v1", "transacciones"]
            },
            "description": "Crea una nueva transacción. El usuario autenticado será el comprador. El producto debe estar disponible y no puede ser propio. Para alquiler incluir fechaFin."
          },
          "response": [
            {
              "name": "Transacción Creada",
              "status": "Created",
              "code": 201,
              "body": "{\n  \"id\": 1,\n  \"tipo\": \"COMPRA\",\n  \"estado\": \"PENDIENTE\",\n  \"monto\": 50.0,\n  \"fechaInicio\": \"2026-05-25T13:55:33.547588\",\n  \"fechaFin\": null,\n  \"compradorNombre\": \"Test\",\n  \"vendedorNombre\": \"User2\",\n  \"productoTitulo\": \"Calculadora Cientifica\"\n}"
